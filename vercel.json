{
  "rewrites": [
    { "source": "/",                    "destination": "/pages/login.html" },
    { "source": "/login",               "destination": "/pages/login.html" },
    { "source": "/participant",         "destination": "/pages/participant.html" },
    { "source": "/admin",               "destination": "/pages/admin.html" },
    { "source": "/admin/login",         "destination": "/pages/admin-login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}